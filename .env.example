# Copy to .env and fill in. Nothing here is required for the open tasks with local models.

# OpenAI-compatible endpoint for the LLM references (e.g. vLLM or Open WebUI)
LLM_BASE_URL=https://llm.example.org/api
LLM_API_KEY=your-llm-key

# Hosts that may receive credentialed (MIMIC) data, and model-name prefixes that never may
MIMIC_ALLOWED_HOSTS=localhost,127.0.0.1,llm.example.org
RESTRICTED_DENY_MODEL_PREFIXES=external-

# Hosted models (public data only)
TYPESAFE_API_KEY=your-typesafe-key
OPENROUTER_API_KEY=your-openrouter-key

# Prepared MIMIC-CXR files (credentialed, see src/jt/config.py)
CXR_SOURCE_DIR=path/to/prepared/mimic-cxr
